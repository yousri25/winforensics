# winforensics configuration
# Copy to ~/.config/winforensics/config.env (install.sh does this for you) and keep it chmod 600.
# Format: KEY=value, no spaces around "=", no inline comments.

# --- Windows account created on first install ---
# NOTE: these are only applied when Windows is first installed. Changing them
# later does NOT change the account inside the VM.
WF_USERNAME=forensics
WF_PASSWORD=change-me

# --- VM resources ---
WF_VERSION=11
WF_RAM=8G
WF_CPUS=4
WF_DISK=64G

# --- Folder shared with the VM (shows up as \\host.lan\Data inside Windows) ---
WF_SHARE=/home/youruser/WinForensics-Share

# --- Behaviour ---
# Stop the VM when the RDP window closes (true/false)
WF_STOP_ON_EXIT=true
# Seconds to wait after Windows starts answering on RDP, before connecting
WF_BOOT_DELAY=20
# Give up if Windows has not answered on RDP after this many seconds (first run installs Windows)
# WF_BOOT_TIMEOUT=5400
# Extra FreeRDP flags. The default fixes the black-screen problem seen with some setups.
WF_RDP_FLAGS=-gfx /gdi:sw
